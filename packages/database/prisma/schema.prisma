  branch      String   @db.VarChar(100)
  commitHash  String   @map("commit_hash") @db.VarChar(64)
  buildStatus String   @map("build_status") @db.VarChar(50) // RUNNING, SUCCESS, FAILED
  triggeredBy String   @map("triggered_by") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deployments DeploymentRecord[]

  @@map("release_pipelines")
}

model DeploymentRecord {
  id              String    @id @default(uuid()) @db.Uuid
  pipelineId      String    @map("pipeline_id") @db.Uuid
  environmentName String    @map("environment_name") @db.VarChar(50) // DEV, QA, STAGING, PRODUCTION
  deployStatus    String    @map("deploy_status") @db.VarChar(50) // PENDING, SUCCESS, FAILED, ROLLED_BACK
  approvedBy      String?   @map("approved_by") @db.Uuid // Admin approver UUID
  approvalToken   String?   @map("approval_token") @db.VarChar(255) // Mandated Production approval credentials
  rollbackLogJson String?   @map("rollback_log_json") @db.Text // Backup details replayed on failures
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  pipeline ReleasePipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  approver User?           @relation("DeploymentApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([pipelineId])
  @@map("deployment_records")
}

model DevSecOpsSecret {
  id                   String   @id @default(uuid()) @db.Uuid
  secretKey            String   @map("secret_key") @db.VarChar(150) // e.g. DATABASE_URL, STRIPE_SECRET
  secretValueEncrypted String   @map("secret_value_encrypted") @db.Text
  environmentName      String   @map("environment_name") @db.VarChar(50) // DEV, STAGING, PRODUCTION
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([secretKey, environmentName])
  @@map("devsecops_secrets")
}

model CompliancePolicy {
  id                 String   @id @default(uuid()) @db.Uuid
  title              String   @db.VarChar(150) // e.g. Terms of Service, Privacy Policy
  version            String   @db.VarChar(50)  // e.g. v1.0, v2.1
  category           String   @db.VarChar(50)  // TOS, PRIVACY, MARKETING, RULES
  status             String   @default("DRAFT") @db.VarChar(50) // DRAFT, REVIEW, APPROVED, ACTIVE, ARCHIVED
  content            String   @db.Text
  regionRestrictions String   @map("region_restrictions") @db.VarChar(100) // e.g. UAE, IN, EU, US
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  consents UserConsent[]

  @@unique([category, version, regionRestrictions])
  @@map("compliance_policies")
}

model UserConsent {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  policyId        String   @map("policy_id") @db.Uuid
  consentedStatus String   @map("consented_status") @db.VarChar(50) // ACCEPTED, REJECTED
  sourcePlatform  String   @map("source_platform") @db.VarChar(50) // WEB, MOBILE
  languageCode    String   @map("language_code") @db.VarChar(10) // EN, AR, ML
  ipAddress       String   @map("ip_address") @db.VarChar(45)
  userAgent       String   @map("user_agent") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy CompliancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_consents")
}

model PrivacyPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  communicationEmail    Boolean  @default(true) @map("communication_email")
  communicationSms      Boolean  @default(false) @map("communication_sms")
  communicationPush     Boolean  @default(true) @map("communication_push")
  profileVisibility     String   @default("PUBLIC") @map("profile_visibility") @db.VarChar(50) // PUBLIC, EMPLOYERS_ONLY, PRIVATE
  searchVisibility      Boolean  @default(true) @map("search_visibility")
  dataSharingPreferences String   @default("EcosystemOnly") @map("data_sharing_preferences") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_preferences")
}

model ImmutableAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  auditCategory String   @map("audit_category") @db.VarChar(50) // AUTH, PAYMENT, MEMBERSHIP, ADMIN, PERMISSION, SENSITIVE
  action        String   @db.VarChar(100) // e.g. PASSWORD_CHANGE, PAYMENT_COMPLETED, ROLE_GRANTED
  details       String   @db.Text
  ipAddress     String   @map("ip_address") @db.VarChar(45)
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([auditCategory])
  @@map("immutable_audit_logs")
}

model ComplianceReport {
  id          String   @id @default(uuid()) @db.Uuid
  reportType  String   @map("report_type") @db.VarChar(100) // e.g. DATA_RETENTION_AUDIT, CONSENT_DISTRIBUTION
  status      String   @default("COMPLETED") @db.VarChar(50)
  summaryText String   @map("summary_text") @db.Text
  generatedBy String   @map("generated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  creator User @relation(fields: [generatedBy], references: [id], onDelete: Cascade)

  @@map("compliance_reports")
}

model ResilienceBackup {
  id                   String   @id @default(uuid()) @db.Uuid
  backupName           String   @unique @map("backup_name") @db.VarChar(150) // e.g. Daily_DB_Snapshot_20260707
  sizeBytes            BigInt   @map("size_bytes")
  backupType           String   @map("backup_type") @db.VarChar(50) // FULL, INCREMENTAL, CONFIG
  status               String   @default("PENDING") @db.VarChar(50) // PENDING, SUCCESS, FAILED
  storageLocation      String   @map("storage_location") @db.VarChar(255) // Target bucket / vault path
  encryptionKeyId      String   @map("encryption_key_id") @db.VarChar(100)
  encryptedPayloadHash String   @map("encrypted_payload_hash") @db.VarChar(64) // SHA-256 integrity hash
  createdAt            DateTime @default(now()) @map("created_at")

  restoreLogs RestoreValidationLog[]

  @@map("resilience_backups")
}

model RestoreValidationLog {
  id               String   @id @default(uuid()) @db.Uuid
  backupId         String   @map("backup_id") @db.Uuid
  restoreStatus    String   @map("restore_status") @db.VarChar(50) // SUCCESS, FAILED
  timeTakenSeconds Int      @map("time_taken_seconds")
  validatedAt      DateTime @default(now()) @map("validated_at")

  backup ResilienceBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@map("restore_validation_logs")
}

model ResiliencePolicy {
  id            String   @id @default(uuid()) @db.Uuid
  policyName    String   @unique @map("policy_name") @db.VarChar(150) // e.g. Daily_Database_Backup, Support_Tickets_Retention
  frequencyCron String   @map("frequency_cron") @db.VarChar(100) // e.g. "0 2 * * *"
  retentionDays Int      @map("retention_days")
  dataClass     String   @map("data_class") @db.VarChar(100) // DATABASE, OBJECT_STORAGE, SYSTEM_CONFIG
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("resilience_policies")
}

model PerformanceBenchmark {
  id                 String   @id @default(uuid()) @db.Uuid
  testName           String   @map("test_name") @db.VarChar(100) // e.g. LOAD_TEST_REGISTRATION, STRESS_TEST_GATEWAY
  serviceName        String   @map("service_name") @db.VarChar(100)
  baselineResponseMs Int      @map("baseline_response_ms")
