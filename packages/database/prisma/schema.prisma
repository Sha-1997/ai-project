  actualResponseMs   Int      @map("actual_response_ms")
  throughputTps      Decimal  @map("throughput_tps") @db.Decimal(10, 2)
  status             String   @default("PASSED") @db.VarChar(50) // PASSED, FAILED
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([testName])
  @@map("performance_benchmarks")
}

model CapacityForecast {
  id                   String   @id @default(uuid()) @db.Uuid
  resourceType         String   @map("resource_type") @db.VarChar(100) // CPU, MEMORY, STORAGE, DATABASE_CONN
  currentUtilization   Decimal  @map("current_utilization") @db.Decimal(5, 2)
  limitValue           Decimal  @map("limit_value") @db.Decimal(12, 2)
  forecastTargetDate   DateTime @map("forecast_target_date")
  forecastedPercentage Decimal  @map("forecasted_percentage") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([resourceType])
  @@map("capacity_forecasts")
}

model CacheMetric {
  id                String   @id @default(uuid()) @db.Uuid
  cacheName         String   @map("cache_name") @db.VarChar(100) // e.g. SEARCH_QUERY_CACHE, PUBLIC_JOBS_CACHE
  hitRatePercentage Decimal  @map("hit_rate_percentage") @db.Decimal(5, 2)
  totalHits         Int      @default(0) @map("total_hits")
  totalMisses       Int      @default(0) @map("total_misses")
  sizeBytes         BigInt   @map("size_bytes")
  recordedAt        DateTime @default(now()) @map("recorded_at")

