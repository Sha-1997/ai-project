datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// 1. IDENTITY & ACCESS CONTROL (RBAC)
// ==============================================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  mobile       String?    @db.VarChar(50)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  status       String     @default("ACTIVE") @db.VarChar(50) // ACTIVE, BLOCKED, SUSPENDED
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  softDeleted  Boolean    @default(false) @map("soft_deleted")
  
  userRoles               UserRole[]
  memberships             Membership[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  savedSearches           SavedSearch[]
  searchHistories         SearchHistory[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
  apiKeys                 ApiKey[]
  recommendationHistories RecommendationHistory[]
  interactionSignals      InteractionSignal[]
  referralCodes           ReferralCode[]
  invitedBy               Referral[]               @relation("InvitedBy")
  invitedUsers            Referral[]               @relation("InvitedUser")
  affiliatePartners       AffiliatePartner[]
  fraudReports            FraudReport[]
  campaignEntries         CampaignEntry[]
  campaignAuditLogs       CampaignAuditLog[]
  operationalIncidents    OperationalIncident[]
  approvedDeployments     DeploymentRecord[]       @relation("DeploymentApprover")
  consents                UserConsent[]
  privacyPreference       PrivacyPreference?
  immutableAuditLogs      ImmutableAuditLog[]
  complianceReports       ComplianceReport[]
  certifications          OperationalCertification[]
  technicalDebtItems      TechnicalDebtItem[]
  employer                Employer?
  candidate               Candidate?

  @@index([email])
  @@index([mobile])
  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  code        String           @unique @db.VarChar(50) // ADMIN, FOUNDER, MEMBER, MODERATOR, SUPPORT
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  code        String           @unique @db.VarChar(100) // e.g., USER_CREATE, BILLING_VIEW
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ==============================================================================
// 2. MEMBERSHIP & BILLING LAYERS
// ==============================================================================

model SubscriptionPlan {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String       @unique @db.VarChar(100)
  code                String       @unique @db.VarChar(50) // FOUNDER, EARLY, GROWTH, SCALE, STANDARD
  description         String?      @db.VarChar(255)
  price               Decimal      @db.Decimal(10, 2) // Base cost in AED
  currency            String       @default("AED") @db.VarChar(10)
  durationDays        Int          @map("duration_days") @default(365)
  maxConcurrentDevice Int          @map("max_concurrent_devices") @default(2)
  status              String       @default("ACTIVE") @db.VarChar(50) // ACTIVE, ARCHIVED
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("subscription_plans")
}

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  planId         String    @map("plan_id") @db.Uuid
  startDate      DateTime  @map("start_date")
  expiryDate     DateTime  @map("expiry_date")
  status         String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, EXPIRED, CANCELED, GRACE
  priceLockUntil DateTime? @map("price_lock_until")
  autoRenew      Boolean   @default(true) @map("auto_renew")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  version        Int       @default(1) // Optimistic Locking

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("memberships")
}

// ==============================================================================
// 3. MASTER GEOGRAPHY (TAX COMPLIANCE)
// ==============================================================================

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(150)
  code      String   @unique @db.VarChar(10) // ISO 2-letter (e.g. AE, SA)
  vatRate   Decimal  @default(0.00) @map("vat_rate") @db.Decimal(5, 4) // e.g. 0.0500 for UAE 5% VAT
  status    String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  jobs      Job[]

  @@index([code])
  @@map("countries")
}

// ==============================================================================
// 4. SYSTEM STORES (SETTINGS, LOGS, NOTIFICATIONS, MODULES)
// ==============================================================================

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(150)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100) // LOGIN, UPDATE, DELETE, etc.
  entityName  String   @map("entity_name") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  previousVal String?  @map("previous_value") @db.Text
  newVal      String?  @map("new_value") @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50) // EMAIL, SMS, IN_APP
  title     String   @db.VarChar(150)
  message   String   @db.Text
  status    String   @default("UNREAD") @db.VarChar(50) // UNREAD, READ
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model AiModule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(50) // ai-jobs, ai-delivery, ai-travel, logistics
  version     String   @default("1.0.0") @db.VarChar(50)
  status      String   @default("PLANNED") @db.VarChar(50) // ACTIVE, TESTING, PLANNED
  entryUrl    String?  @map("entry_url") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([status])
  @@map("ai_modules")
}

// ==============================================================================
// 5. CONTENT MANAGEMENT SYSTEM (CMS)
// ==============================================================================

model ContentPage {
  id             String           @id @default(uuid()) @db.Uuid
  title          String           @db.VarChar(255)
  slug           String           @unique @db.VarChar(255)
  status         String           @default("DRAFT") @db.VarChar(50) // DRAFT, REVIEW, APPROVED, PUBLISHED, ARCHIVED
  language       String           @default("en") @db.VarChar(10)
  seoTitle       String?          @map("seo_title") @db.VarChar(255)
  seoDescription String?          @map("seo_description") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  blocks         ContentBlock[]
  versions       ContentVersion[]

  @@index([slug])
  @@index([status])
  @@map("content_pages")
}

model ContentBlock {
  id           String      @id @default(uuid()) @db.Uuid
  pageId       String      @map("page_id") @db.Uuid
  blockType    String      @map("block_type") @db.VarChar(100) // HERO, TEXT, IMAGE, TIMELINE, PRICING, FAQ
  sortOrder    Int         @map("sort_order") @default(0)
  blockContent String      @map("block_content") @db.Text // JSON snapshot containing fields
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  page         ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("content_blocks")
}

model ContentVersion {
  id            String      @id @default(uuid()) @db.Uuid
  pageId        String      @map("page_id") @db.Uuid
  versionNumber Int         @map("version_number")
  blockSnapshot String      @map("block_snapshot") @db.Text // JSON snapshot of all blocks
  author        String      @db.VarChar(150)
  createdAt     DateTime    @default(now()) @map("created_at")

  page          ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, versionNumber])
  @@map("content_versions")
}

model MediaLibrary {
  id        String   @id @default(uuid()) @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  fileUrl   String   @map("file_url") @db.VarChar(255)
  folderPath String  @map("folder_path") @default("/") @db.VarChar(255)
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media_library")
}

// ==============================================================================
// 6. AI JOBS MULTI-SIDED PLATFORM LAYERS
// ==============================================================================

model Employer {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  role           String   @default("RECRUITER") @db.VarChar(50) // OWNER, ADMIN, RECRUITER, HIRING_MANAGER, HR, READ_ONLY
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@index([userId])
  @@index([organizationId])
  @@index([role])
  @@map("employers")
}

model Candidate {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @unique @map("user_id") @db.Uuid
  resumeUrl                 String?  @map("resume_url") @db.VarChar(255)
  visibilityStatus          String   @default("VISIBLE") @map("visibility_status") @db.VarChar(50) // VISIBLE, PRIVATE
  preferredLocation         String?  @map("preferred_location") @db.VarChar(255)
  experienceYears           Int      @default(0) @map("experience_years")
  educationLevel            String?  @map("education_level") @db.VarChar(150)
  
  // Future-Ready AI Recruiting Fields
  aiProfileSnapshot         String?  @map("ai_profile_snapshot") @db.Text // JSON string caching parsed resume details
  skillAssessmentScore      Decimal? @map("skill_assessment_score") @db.Decimal(5, 2)
  aiMatchScorePlaceholder   Decimal? @map("ai_match_score_placeholder") @db.Decimal(5, 2)
  
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateSkills  CandidateSkill[]
  applications     JobApplication[]
  workExperiences  WorkExperience[]
  educations       Education[]
  certifications   Certification[]
  resumeFiles      ResumeFile[]

  @@index([userId])
  @@index([visibilityStatus])
  @@map("candidates")
}

model JobCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("job_categories")
}

model Skill {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  id                    String   @id @default(uuid()) @db.Uuid
  candidateId           String   @map("candidate_id") @db.Uuid
  skillId               String   @map("skill_id") @db.Uuid
  selfAssessmentRating  Int      @default(1) @map("self_assessment_rating") // 1-5 rating scale
  verifiedByAssessment  Boolean  @default(false) @map("verified_by_assessment")
  createdAt             DateTime @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@map("candidate_skills")
}

model Job {
  id                      String   @id @default(uuid()) @db.Uuid
  employerId              String   @map("employer_id") @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  title                   String   @db.VarChar(255)
  department              String?  @db.VarChar(150)
  description             String   @db.Text
  categoryId              String   @map("category_id") @db.Uuid
  experienceRequiredYears Int      @default(0) @map("experience_required_years")
  educationRequirement    String?  @map("education_requirement") @db.VarChar(255)
  salaryMin               Decimal? @map("salary_min") @db.Decimal(12, 2)
  salaryMax               Decimal? @map("salary_max") @db.Decimal(12, 2)
  negotiableSalary        Boolean  @default(false) @map("negotiable_salary")
  isSalaryHidden          Boolean  @default(false) @map("is_salary_hidden")
  currency                String   @default("AED") @db.VarChar(10)
  employmentType          String   @map("employment_type") @db.VarChar(50) // Full-time, Contract, etc.
  workMode                String   @default("REMOTE") @map("work_mode") @db.VarChar(50) // REMOTE, HYBRID, ONSITE
  locationDetails         String?  @map("location_details") @db.VarChar(255)
  countryCode             String   @map("country_code") @db.VarChar(10)
  benefits                String?  @db.Text
  vacancyCount            Int      @default(1) @map("vacancy_count")
  applicationDeadline     DateTime? @map("application_deadline")
  scheduledPublishAt      DateTime? @map("scheduled_publish_at")
  status                  String   @default("DRAFT") @db.VarChar(50) // DRAFT, UNDER_REVIEW, APPROVED, SCHEDULED, PUBLISHED, ACTIVE, PAUSED, CLOSED, EXPIRED, ARCHIVED
  customFieldsJson        String?  @map("custom_fields_json") @db.Text // PM recommended custom fields framework
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  employer     Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     JobCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  country      Country          @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  jobSkills    JobSkill[]
  applications JobApplication[]
  histories    JobHistory[]

  @@index([employerId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([countryCode])
  @@index([status])
  @@map("jobs")
}

model JobSkill {
  id               String   @id @default(uuid()) @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  skillId          String   @map("skill_id") @db.Uuid
  importanceWeight Decimal  @default(1.0) @map("importance_weight") @db.Decimal(3, 2) // 0.0 to 1.0 importance factor
  createdAt        DateTime @default(now()) @map("created_at")

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@map("job_skills")
}

model JobApplication {
  id            String   @id @default(uuid()) @db.Uuid
  candidateId   String   @map("candidate_id") @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  resumeFileId  String   @map("resume_file_id") @db.Uuid
  coverLetter   String?  @map("cover_letter") @db.Text
  currentStage  String   @default("APPLIED") @map("current_stage") @db.VarChar(50) // APPLIED, SUBMITTED, UNDER_REVIEW, SHORTLISTED, INTERVIEW, ASSESSMENT, FINAL_REVIEW, OFFER_EXTENDED, HIRED, REJECTED, WITHDRAWN, CLOSED
  status        String   @default("ACTIVE") @db.VarChar(50) // ACTIVE, ARCHIVED
  source        String   @default("JOVIANEX_SEARCH") @db.VarChar(50) // JOVIANEX_SEARCH, DIRECT_LINK, REFERRAL, QR_CODE, CAMPAIGN
  notes         String?  @db.Text
  matchScore    Decimal? @map("match_score") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  candidate    Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeFile   ResumeFile         @relation(fields: [resumeFileId], references: [id], onDelete: Restrict)
  events       ApplicationEvent[]

  @@index([candidateId])
  @@index([organizationId])
  @@index([jobId])
  @@index([currentStage])
  @@map("job_applications")
}

model WorkExperience {
  id              String    @id @default(uuid()) @db.Uuid
  candidateId     String    @map("candidate_id") @db.Uuid
  companyName     String    @map("company_name") @db.VarChar(255)
  position        String    @db.VarChar(255)
  employmentType  String    @map("employment_type") @db.VarChar(50) // Full-time, Part-time, Contract, etc.
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  responsibilities String?  @db.Text
  achievements     String?  @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("work_experiences")
}

model Education {
  id             String    @id @default(uuid()) @db.Uuid
  candidateId    String    @map("candidate_id") @db.Uuid
  institution    String    @db.VarChar(255)
  degree         String    @db.VarChar(255)
  specialization String?   @db.VarChar(255)
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_education")
}

model Certification {
  id                 String    @id @default(uuid()) @db.Uuid
  candidateId        String    @map("candidate_id") @db.Uuid
  certificateName    String    @map("certificate_name") @db.VarChar(255)
  issuingOrganization String   @map("issuing_organization") @db.VarChar(255)
  issueDate          DateTime  @map("issue_date")
  expiryDate         DateTime? @map("expiry_date")
  credentialUrl      String?   @map("credential_url") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_certifications")
}

model ResumeFile {
  id                String   @id @default(uuid()) @db.Uuid
  candidateId       String   @map("candidate_id") @db.Uuid
  fileUrl           String   @map("file_url") @db.VarChar(255)
  fileName          String   @map("file_name") @db.VarChar(255)
  isDefault         Boolean  @default(false) @map("is_default")
  versionNumber     Int      @default(1) @map("version_number")
  uploadSource      String   @default("UPLOAD") @map("upload_source") // MANUAL, UPLOAD, AI_GENERATED
  parsedResumeJson  String?  @map("parsed_resume_json") @db.Text // PM recommended structured resume snapshot
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  candidate Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@map("resume_files")
}

model Organization {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @map("organization_name") @db.VarChar(255)
  legalName          String   @map("legal_name") @db.VarChar(255)
  registrationNumber String?  @map("registration_number") @db.VarChar(100)
  industry           String?  @db.VarChar(150)
  companySize        String?  @map("company_size") @db.VarChar(50)
  websiteUrl         String?  @map("website_url") @db.VarChar(255)
  contactEmail       String?  @map("contact_email") @db.VarChar(255)
  contactPhone       String?  @map("contact_phone") @db.VarChar(50)
  headquartersCountry String  @map("headquarters_country") @db.VarChar(100)
  headquartersCity    String  @map("headquarters_city") @db.VarChar(100)
  timeZone           String   @default("Asia/Dubai") @map("time_zone") @db.VarChar(100)
  verificationStatus String   @default("PENDING") @map("verification_status") @db.VarChar(50) // PENDING, DOCUMENT_SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED, SUSPENDED
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employers             Employer[]
  branches              BranchOffice[]
  documents             VerificationDocument[]
  recruiterInvitations  RecruiterInvitation[]
  jobs                  Job[]
  templates             JobTemplate[]
  applications          JobApplication[]

  @@index([verificationStatus])
  @@map("organizations")
}

model BranchOffice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  address        String   @db.VarChar(255)
  country        String   @db.VarChar(100)
  city           String   @db.VarChar(100)
